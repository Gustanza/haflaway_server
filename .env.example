PORT=8080

# Path to the service account key JSON downloaded from Firebase Console
# (Project Settings -> Service Accounts -> Generate new private key).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

FIREBASE_PROJECT_ID=haflaway-f14aa
FIREBASE_STORAGE_BUCKET=haflaway-f14aa.appspot.com

# ── Dispatch credentials (src/dispatch/whatsapp.js, src/dispatch/sms.js) ────
# Real values live in functions/utils/constants.js (twWspPhn/twAcnSid/
# twAuthToken) and functions/sms/beem.js + onfon.js — copy them from there
# into your real .env. Never real secrets here; this file is committed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
BEEM_API_KEY=
BEEM_SECRET_KEY=
ONFON_USERNAME=
ONFON_PASSWORD=
# Platform-wide fallback for orgs that haven't set their own smtz /
# wasambazie credentials from the SMS Providers tab (Organization settings)
# — see resolveOrgSmsCredentials in src/dispatch/sms.js. Optional; copy the
# real values from functions/sms/wasambazie.js into your real .env.
SMTZ_API_KEY=
WASAMBAZIE_PUBLIC_KEY=
WASAMBAZIE_SECRET_KEY=

# ── Render concurrency (see src/config.js for the full reasoning) ───────────
# Run `nproc` on the actual VPS and set this to the real core count — 6 here
# is a documented ASSUMPTION (Contabo's common pairing for 24GB RAM tiers),
# not a detected value.
CARD_SERVER_VPS_CORES=6
# Uncomment to override the calculated concurrency directly instead of
# deriving it from RAM/CPU:
# CARD_RENDER_CONCURRENCY=5
# CARD_SERVER_VPS_RAM_MB=24576
# CARD_SERVER_RESERVED_RAM_MB=4096
# CARD_RENDER_MB_PER_JOB=500
